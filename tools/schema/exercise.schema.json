{
  "$id": "exercise.schema.json",
  "title": "Exercise exercise.yaml",
  "type": "object",
  "required": ["id", "kind", "title", "difficulty", "tags", "hints"],
  "properties": {
    "id": { "type": "string", "pattern": "^p[0-9]-[0-9]{2}-ex[0-9]{2}$" },
    "kind": { "enum": ["code", "fill", "debug", "project"] },
    "title": { "$ref": "common.schema.json#/$defs/i18nText" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "hints": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
        "vi": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
      },
      "additionalProperties": false
    },
    "solution_unlock_attempts": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
