# Optional. Without these the app runs in guest mode (progress in localStorage only).
# Supabase -> Project Settings -> API. The anon key is public by design; security comes from RLS (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional. RAG AI Assistant backend URL (e.g. Cloudflare tunnel or local http://127.0.0.1:8000).
# Without this variable, the AI assistant chat widget remains completely hidden.
NEXT_PUBLIC_RAG_URL=http://127.0.0.1:8000

