{
  "$id": "meta.schema.json",
  "title": "Lesson meta.yaml",
  "type": "object",
  "required": ["id", "phase", "order", "title", "summary", "level", "tags", "duration_min", "outcomes", "review_by"],
  "properties": {
    "id": { "type": "string", "pattern": "^p[0-9]-[0-9]{2}-[a-z0-9-]+$" },
    "phase": { "type": "string", "pattern": "^p[0-9]$" },
    "order": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["lesson", "project"] },
    "title": { "$ref": "common.schema.json#/$defs/i18nText" },
    "summary": { "$ref": "common.schema.json#/$defs/i18nText" },
    "level": { "enum": ["beginner", "intermediate", "applied"] },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "duration_min": { "type": "integer", "minimum": 3, "maximum": 90 },
    "outcomes": { "$ref": "common.schema.json#/$defs/i18nList" },
    "review_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "further_reading": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "$ref": "common.schema.json#/$defs/i18nText" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
